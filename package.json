{
  "name": "grafio",
  "version": "6.0.3",
  "description": "A graph database with pluggable storage architecture. Supports multiple isolated graphs via graphId partitioning. Ships with a zero-dependency in-memory provider. Includes BFS/DFS traversal, type/property filtering, topological sort, DAG detection, transaction support, and Mermaid export.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.prod.json",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm run build:prod",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=html",
    "perf": "ts-node --project tsconfig.perf.json tests/perf/entryPoint.ts",
    "perf:gc": "cross-env TS_NODE_PROJECT=tsconfig.perf.json node --expose-gc -r ts-node/register tests/perf/entryPoint.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "require": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./testing": {
      "import": "./dist/shared/testing/index.js",
      "require": "./dist/shared/testing/index.js",
      "types": "./dist/shared/testing/index.d.ts"
    },
    "./testing/perf": {
      "import": "./dist/shared/testing/perf/index.js",
      "require": "./dist/shared/testing/perf/index.js",
      "types": "./dist/shared/testing/perf/index.d.ts"
    }
  },
  "keywords": [
    "graph",
    "database",
    "in-memory",
    "typescript",
    "async",
    "transactions",
    "traversal",
    "graph-database",
    "graph-data-structure",
    "dag",
    "serialization",
    "topological-sort",
    "mermaid"
  ],
  "author": "Satya Jugran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/satya-jugran/grafio"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
